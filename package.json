{
  "name": "next-response-kit",
  "version": "1.0.0",
  "description": "Centralized, typed API response helpers for Next.js App Router. Consistent shape, zero config, full TypeScript support.",
  "author": "Shrikant Yadav",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "next.js",
    "api",
    "response",
    "helper",
    "typescript",
    "app-router",
    "route-handler",
    "rest",
    "json",
    "http",
    "nextresponse",
    "server"
  ],
  "homepage": "https://github.com/shrikantyadav/next-response-kit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/shrikantyadav/next-response-kit.git"
  },
  "bugs": {
    "url": "https://github.com/shrikantyadav/next-response-kit/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --sourcemap",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "next": ">=13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "next": "^15.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
