{
  "name": "next-response-kit",
  "version": "2.0.0",
  "description": "Drop-in NextResponse replacement for Next.js App Router — consistent API shape, full TypeScript, zero config.",
  "author": "Shrikant Yadav",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "next.js",
    "nextresponse",
    "api",
    "response",
    "helper",
    "typescript",
    "app-router",
    "route-handler",
    "rest",
    "json",
    "http",
    "server"
  ],
  "homepage": "https://github.com/shrikant9907/next-response-kit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/shrikant9907/next-response-kit.git"
  },
  "bugs": {
    "url": "https://github.com/shrikant9907/next-response-kit/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts --clean --sourcemap",
    "dev": "tsup index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "next": ">=13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "next": "^15.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
